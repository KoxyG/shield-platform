# Copy to .env; Bun loads it automatically.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Database name comes from the path.
MONGODB_URI=mongodb://localhost:27017/shieldzk

# Comma-separated origins allowed to call the API (the web app's dev server by default).
CORS_ORIGINS=http://localhost:5173

# Encrypts stored claim data (each recipient's secret). Unset, the batch routes
# (/v1/batches) are off. Generate your own:
#   openssl rand -base64 32
# Keep it out of git. Claim data stored under one key can't be read with another.
CLAIM_DATA_KEY=

# shield-contracts' circuits directory, to prove batches (POST /v1/batches/:id/prove).
# Needs Node on the PATH, `pnpm install` in that directory, and the conservation_main
# keys in its build/ (ADR 0002: a Powers of Tau of at least 2^20; see D3):
#   PTAU=/path/to/powersOfTau28_hez_final_20.ptau bash scripts/groth16-setup.sh conservation_main 20
# Unset, the API runs without proving.
# CONSERVATION_CIRCUITS_DIR=../../../shield-contracts/circuits

# The ShieldVault batches are funded on (POST /v1/batches/:id/funding checks it).
# All three or none; unset, funding can't be confirmed. Testnet, for example:
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# VAULT_CONTRACT_ID=CBAL4VIZI6MUKVAMYMWQW3VHB3Y7X7A6LAYZTWSKJCHYNFCXF2VC4MVP
